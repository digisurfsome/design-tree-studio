# ===========================================
# SKYVERN CONFIGURATION
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# -----------------------------------------
# LLM PROVIDER KEYS
# -----------------------------------------
# At least one is required. Claude recommended for best reasoning.

ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here

# Optional: Google Gemini
# GOOGLE_API_KEY=your-key-here

# -----------------------------------------
# SKYVERN API KEY
# -----------------------------------------
# Used to authenticate requests to your Skyvern instance
# Generate a secure random key:
#   openssl rand -hex 32

SKYVERN_API_KEY=sk-local-your-secure-key-here

# -----------------------------------------
# DOPPLER (Optional - for secrets management)
# -----------------------------------------
# If using Doppler, these will be injected automatically
# DOPPLER_TOKEN=dp.st.your-token

# -----------------------------------------
# HOSTING PROVIDER KEYS (for factory automation)
# -----------------------------------------
DIGITALOCEAN_API_KEY=your-do-key
VULTR_API_KEY=your-vultr-key
CLOUDFLARE_API_KEY=your-cf-key
CLOUDFLARE_ZONE_ID=your-zone-id

# -----------------------------------------
# EMAIL / SMTP (for app deployments)
# -----------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-key
